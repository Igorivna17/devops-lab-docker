Vagrant.configure("2") do |config|

  # Перша віртуальна машина: Ubuntu
  config.vm.define "web" do |web|
    web.vm.box = "generic/ubuntu2004"
    web.vm.hostname = "ubuntu-node"

    web.vm.provider "vmware_desktop" do |v|
      v.gui = false
      v.vmx["memsize"] = "1024"          # 1 ГБ RAM
      v.vmx["numvcpus"] = "1"           # 1 процесорне ядро
    end
  end

  # Друга віртуальна машина: Debian
  config.vm.define "db" do |db|
    db.vm.box = "generic/debian11"
    db.vm.hostname = "debian-node"

    web_provider = db.vm.provider "vmware_desktop" do |v|
      v.gui = false
      v.vmx["memsize"] = "2048"          # 2 ГБ RAM
      v.vmx["numvcpus"] = "2"           # 2 процесорні ядра
    end
  end

end
